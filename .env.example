# Composition root (см. tasks.md, Задача 13) читает эти переменные при
# старте (crates/bin/app/src/config.rs). Скопируйте в `.env` и заполните.

# Путь к файлу SQLite. Файл и схема создаются автоматически при первом запуске.
DATABASE_URL=sqlite://./workbeat.db

# Токен бота, выданный @BotFather.
TELEGRAM_BOT_TOKEN=

# Ниже — необязательные параметры, при отсутствии берутся значения по
# умолчанию из README.md раздела 7.

# Шаг опроса PollLoop (Задача 10), секунды.
# POLL_INTERVAL_SECS=60

# Через сколько часов простоя (день открыт, активного интервала нет)
# присылать "Готовы продолжить работу?" (PromptContinueIfIdle, Задача 8).
# IDLE_PROMPT_THRESHOLD_HOURS=2

# Расписание напоминаний при молчании внутри десятиминутки (README.md
# раздел 2, п.3 / раздел 7): первые REMINDER_BURST_WINDOW_MINUTES минут —
# раз в REMINDER_BURST_INTERVAL_MINUTES, дальше — раз в
# REMINDER_STEADY_INTERVAL_MINUTES.
# REMINDER_BURST_WINDOW_MINUTES=5
# REMINDER_BURST_INTERVAL_MINUTES=1
# REMINDER_STEADY_INTERVAL_MINUTES=5
